# Google Gemini API Configuration (using Service Account)
GOOGLE_SERVICE_ACCOUNT_JSON=/path/to/service-account-key.json
GEMINI_MODEL=gemini-1.5-pro

# GitHub Integration (optional, for real PR creation)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxx
GITHUB_REPO=username/repo-name

# Feature Flags
ENABLE_LLM_DETECTION=true
ENABLE_GITHUB_INTEGRATION=false
ENABLE_SEMANTIC_ANOMALY=true
ENABLE_BREACH_CHECK=false
